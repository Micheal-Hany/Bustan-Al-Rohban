  "aliases": [
    "القديس الأول",
    "فيك ون"
  ],
  "sections": [
    {
      "id": "sec-fake-one-001",
      "title": "[تجريبي] القسم الأول",
      "order": 1,
      "pageStart": 1,
      "pageEnd": 2,
      "paragraphs": [
        {
          "id": "p-000001",
          "order": 1,
          "kind": "body",
          "page": 1,
          "text": "هذه فقرة تجريبية أولى. ليست من الكتاب."
        },
        {
          "id": "p-000002",
          "order": 2,
          "kind": "body",
          "page": 1,
          "text": "هَذِهِ فِقْرَةٌ تَجْرِيبِيَّةٌ ثَانِيَةٌ بِالتَّشْكِيلِ. لَيْسَتْ مِنَ الْكِتَابِ."
        },
        {
          "id": "p-000003",
          "order": 3,
          "kind": "heading",
          "page": 2,
          "text": "[تجريبي] عنوان فرعي"
        },
        {
          "id": "p-000004",
          "order": 4,
          "kind": "body",
          "page": 2,
          "text": "هذه فقرة تجريبية ثالثة تبدأ في الصفحة الثانية. ليست من الكتاب."
        }
      ]
    },
    {
      "id": "sec-fake-one-002",
      "title": "[تجريبي] القسم الثاني",
      "order": 2,
      "pageStart": 3,
      "pageEnd": 3,
      "paragraphs": [
        {
          "id": "p-000005",
          "order": 1,
          "kind": "body",
          "page": 3,
          "text": "هذه فقرة تجريبية رابعة. ليست من الكتاب."
        },
        {
          "id": "p-000006",
          "order": 2,
          "kind": "body",
          "page": 3,
          "text": "هذه فقرة تجريبية خامسة بسطرين.\nالسطر الثاني من الفقرة الخامسة."
        }
      ]
    },
    {
      "id": "sec-fake-one-003",
      "title": "[تجريبي] القسم الثالث",
      "order": 3,
      "pageStart": null,
      "pageEnd": null,
      "paragraphs": [
        {
          "id": "p-000007",
          "order": 1,
          "kind": "body",
          "page": null,
          "text": "هذه فقرة تجريبية سادسة بلا رقم صفحة معروف. ليست من الكتاب."
        }
      ]
    }
  ]
}
