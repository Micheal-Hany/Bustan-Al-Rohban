{
  "name": "bustan-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless book-only RAG backend for the Bustan Al-Rohban app (Task 10b: chat pipeline, validation, safety policy, evaluation set).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"eval/**/*.ts\" \"tools/**/*.ts\"",
    "eval": "ts-node eval/run.ts",
    "reports:list": "ts-node tools/reports-list.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
