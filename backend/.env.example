# Copy to .env (never commit .env). Task 10a needs none of the provider keys.
PORT=3000
# Folder with manifest.json + saints/*.json (the same files the app ships).
CORPUS_DIR=../assets/content
# The FAKE fixture corpus is refused when NODE_ENV=production.
NODE_ENV=development
# Debug endpoint POST /v1/retrieve (always off in production).
ENABLE_RETRIEVE_ENDPOINT=true

# --- Task 10c: model provider (chosen here, not in code) ---
# fake (default, dev/tests only; refused in production) | openai | gemini
LLM_PROVIDER=fake
# Required for openai/gemini. No default: pick the model you have priced in config/pricing.json.
LLM_MODEL=
# Secrets: set only the key of the chosen provider. Never commit. Only sent in a request header.
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=1200
# Versioned price table (USD per 1M tokens, keys "provider:model").
PRICING_FILE=config/pricing.json

# --- Task 10d: abuse protection and spend controls (PROPOSED defaults; owner decides, SPEC 19 #5) ---
# Number of reverse-proxy hops in front of the app (so the real client IP is used for limits).
TRUST_PROXY_HOPS=0
RATE_IP_MAX=60
RATE_IP_WINDOW_SECONDS=3600
RATE_INSTALLATION_MAX=20
RATE_INSTALLATION_WINDOW_SECONDS=3600
# Global daily cap in USD (UTC day). Reaching it makes the assistant "temporarily unavailable".
DAILY_SPEND_CAP_USD=5
# Charged to the daily total when a call's real cost is unknown (missing usage / unpriced model).
UNKNOWN_COST_USD=0.02
# Manual kill switch (restart to change): true refuses every model call.
AI_KILL_SWITCH=false
MAX_CONCURRENT_MODEL_CALLS=8
# off (dev only) | test (dev/CI/emulator, fixed token) | play_integrity (required in production)
ATTESTATION_MODE=off
ATTESTATION_TEST_TOKEN=
PLAY_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Optional comma list of allowed app-signing certificate SHA-256 digests (base64).
PLAY_CERT_SHA256=
ATTESTATION_MAX_AGE_SECONDS=300
