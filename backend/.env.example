# Copy to .env (never commit .env). Task 10a needs none of the provider keys.
PORT=3000
# Folder with manifest.json + saints/*.json (the same files the app ships).
CORPUS_DIR=../assets/content
# The FAKE fixture corpus is refused when NODE_ENV=production.
NODE_ENV=development
# Debug endpoint POST /v1/retrieve (always off in production).
ENABLE_RETRIEVE_ENDPOINT=true
